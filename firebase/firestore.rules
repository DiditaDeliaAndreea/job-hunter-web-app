rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/jobs/{jobId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/cvs/{cvId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/prompt_preferences/{preferenceId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /searchHistory/{documentId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'Id',
          'Text'
        ])
        && request.resource.data.keys().hasOnly([
          'Id',
          'Text'
        ])
        && request.resource.data.Id is int
        && request.resource.data.Id > 0
        && request.resource.data.Text is string
        && request.resource.data.Text.size() > 0
        && request.resource.data.Text.size() <= 100;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}